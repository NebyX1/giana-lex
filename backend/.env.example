LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TEMPERATURE=
EXAMPLES_TOP_K=3

# Compatibilidad opcional con una instalacion Ollama existente:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=glm-5.2:cloud

# Base relacional. En producción, use MariaDB y una base dedicada.
# DATABASE_URL=mysql+pymysql://giana_legal:change-me@127.0.0.1:3306/giana_lex?charset=utf8mb4
LEGAL_STORAGE_DIR=
LEGAL_ADMIN_KEY=
LEGAL_ALLOW_LOCAL_ADMIN=true

# Instancia Qdrant existente. Estas colecciones son nuevas; no se reutilizan colecciones de origen desconocido.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_RESOLUTION_TAXONOMY_COLLECTION=giana_resolution_taxonomy_v2
QDRANT_RESOLUTION_EXAMPLES_COLLECTION=giana_resolution_examples_v2
LEGAL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es
LEGAL_EMBEDDING_DIMENSION=768
LEGAL_EMBEDDING_CACHE_DIR=
LEGAL_IMPORT_TIMEOUT_SECONDS=20
LEGAL_IMPORT_RATE_LIMIT_SECONDS=0.45
LEGAL_IMPORT_RETRIES=2

# Autenticación, sesión y correo. No copie secretos desde sample-backend/.env.
SECRET_KEY=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
RATELIMIT_STORAGE_URI=memory://
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_SUPPRESS_SEND=false
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
