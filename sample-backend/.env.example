FLASK_CONFIG=development
# Development may opt in. Production images and deployments default to false;
# run `flask --app wsgi:app db upgrade` once as a release job instead.
RUN_MIGRATIONS_ON_START=false
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///instance/giana_lex.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production MariaDB example:
# DATABASE_URL=mariadb+mariadbconnector://user:password@host:3306/giana_lex

REDIS_URL=
RATELIMIT_STORAGE_URI=memory://
LEGAL_DISPATCHER=inline
LEGAL_REDIS_STREAM=giana:legal:commands
LEGAL_REDIS_CONSUMER_GROUP=legal-workers
LEGAL_REDIS_CONSUMER_NAME=legal-worker-1
LEGAL_OUTBOX_MAX_ATTEMPTS=5
LEGAL_WORKER_MAX_RETRIES=5
LEGAL_WORKER_CLAIM_IDLE_MS=30000
LEGAL_WORKER_HEARTBEAT_KEY=giana:legal:worker:heartbeat
LEGAL_WORKER_HEARTBEAT_TTL_SECONDS=15
LEGAL_CASE_LOCK_TTL_SECONDS=120
LEGAL_SSE_WAIT_SECONDS=15
LEGAL_SSE_POLL_INTERVAL=0.5
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
TRUSTED_PROXY_COUNT=0
FORCE_HTTPS=false

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Credential encryption (Fernet). Format: key_id:64-byte-hex-key[,old_id:old_key...]
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ACTIVE_KEY_ID=

# ChatGPT Plus/Pro OAuth (same PKCE flow as OpenAI Codex / OpenCode)
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_AUTHORIZE_URL=https://auth.openai.com/oauth/authorize
OPENAI_TOKEN_URL=https://auth.openai.com/oauth/token
OPENAI_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_API_BASE_URL=https://chatgpt.com/backend-api/codex
OPENAI_ORIGINATOR=giana-lex

# Provider HTTP settings
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_READ_TIMEOUT=120
PROVIDER_ALLOWED_PRIVATE_HOSTS=

# Chat limits
CHAT_MAX_MESSAGES=50
CHAT_MAX_MESSAGE_CHARS=12000
AGENT_MAX_STEPS=16
AGENT_RUNS_PER_MINUTE=10 per minute

# Harness governance. Adaptive is recommended; disable for exact legacy flow.
HARNESS_ENABLED=true
HARNESS_MODE=adaptive
HARNESS_MAX_ITERATIONS=16
HARNESS_MAX_RETRIES=2
HARNESS_MAX_TOOL_CALLS=15
HARNESS_MAX_LLM_CALLS=10
HARNESS_RETRY_BACKOFF_SECONDS=0.75
HARNESS_CONTEXT_MAX_CHARS=24000
HARNESS_DEBUG=false
LLM_CAPABILITY_PROFILE=balanced
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
LLM_FALLBACK_MODELS=

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional injected reranker. Disabled by default; hybrid dense + local BM25 remains local.
RAG_RERANK_ENABLED=false
DOCUMENT_MAX_BYTES=20971520

# Generic JSON search provider. Expected response: {"results": [{"title", "url", "snippet"}]}
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
WEB_ALLOWED_HOSTS=
