{
  "name": "giana-lex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k --success command-2 -n backend,vite,electron \"npm:dev:backend\" \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:backend": "\"backend\\.venv\\Scripts\\python.exe\" backend\\wsgi.py",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5000/health http-get://127.0.0.1:5173 && electron --enable-logging .",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "jsdom": "^26.1.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  }
}
